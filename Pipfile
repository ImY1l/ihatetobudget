[[source]]
name = "pypi"
url = "https://pypi.org/simple"
verify_ssl = true

[dev-packages]
pre-commit = "*"
coverage = "*"
pytest = "*"
pytest-django = "*"
pytest-cov = "*"

[packages]
# Preventive maintenance: Django LTS upgrade
# (Original project targeted Django 3.1)
django = "==4.2.11"

# Keep existing app deps compatible with Django 4.2
# (left as "*" to minimize breakage; if you want pinned versions,
# we can do that after the upgrade is validated)
django-colorfield = "*"
daphne = "*"
django-mathfilters = "*"
django-crontab = "*"
python-dateutil = "*"

[requires]
python_version = "3.10"


